# Optional: enables the "AI Mention Probe" (asks Claude buyer-style questions
# and checks whether your brand is recommended). The free audit works without it.
ANTHROPIC_API_KEY=

# Requests per IP per hour for the public API (in-memory limiter).
RATE_LIMIT_PER_HOUR=20

# Where upgrade / waitlist sign-ups are sent (JSON POST). Works with Zapier,
# Make, n8n, Google Apps Script, etc.
LEAD_WEBHOOK_URL=

# Public URL of your deployment (used for metadata, badges and share links).
NEXT_PUBLIC_SITE_URL=https://citeable.app
